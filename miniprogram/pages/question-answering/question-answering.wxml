<!--question-answering.wxml-->
<view class="question-answering-container">
  <!-- 动态内容区域 -->
  <view class="content-wrapper" wx:if="{{showContent}}">
    <view class="section-header">
      <text class="section-title">三、回答问题（共{{maxScore}}分）</text>
    </view>

    <view class="question-content">
      <!-- 固定旁白文字 -->
      <view class="instruction-text">现在，你有15秒钟的时间阅读这四个问题。</view>

      <!-- 四个问题列表 -->
      <view class="questions-list">
        <view
          class="question-item"
          wx:for="{{questions}}"
          wx:key="index"
          wx:for-index="index"
        >
          <view class="question-text">{{item.content}}</view>
        </view>
      </view>
    </view>
  </view>

  <!-- 播放音频倒计时（旁白音频或短文音频） -->
  <countdown-timer
    id="audioTimer"
    duration="{{currentAudioDuration}}"
    label="{{currentStepText}}"
    bind:finish="onAudioTimerFinish"
    wx:if="{{showAudioTimer}}"
  />

  <!-- 阅读题目倒计时 -->
  <countdown-timer
    id="readingTimer"
    duration="{{readingDuration}}"
    label="{{currentStepText}}"
    bind:finish="onReadingTimerFinish"
    wx:if="{{showReadingTimer}}"
  />
</view>
