<!--passage-retelling.wxml-->
<view class="passage-retelling-container">
  <!-- 题目标题 -->
  <view class="question-title" wx:if="{{questionTitle}}">{{questionTitle}}</view>
  
  <!-- 第一部分和第二部分：共用白色底板 -->
  <view class="content-wrapper">
    <view class="section-header">
      <text class="section-title">三、短文复述及提问（共11分）</text>
    </view>
    
    <view class="question-content">
      <view class="section-subtitle">第一节 短文复述（8分）</view>
      <view class="content-text">
        <text>你将听到{{theme}}，录音播放两遍。请根据所听到的内容，依据思维导图的提示，在60秒内复述短文。</text>
      </view>
      <view class="content-text">
        <text>现在，你有15秒钟的时间阅读思维导图。</text>
      </view>
      <view class="content-text">
        <text>你的复述可以这样开始：{{example}}</text>
      </view>
      <!-- 思维导图图片 -->
      <image 
        wx:if="{{imgUrl}}" 
        class="mind-map-image" 
        src="{{imgUrl}}" 
        mode="aspectFit"
      ></image>
    </view>
  </view>
  
  <!-- 第三部分：时间控制区域 -->
  <view class="timer-control">
    <view class="timer-button-container">
      <view 
        class="timer-button"
        bindtap="onTimerToggle"
      >
        <!-- 进度圆圈：从顶部开始，逐渐显现绿色边框 -->
        <view class="timer-progress-ring">
          <!-- 右半圆边框：显示0-180度的部分 -->
          <view class="progress-half-wrapper progress-right-wrapper">
            <view class="progress-half progress-right" style="transform: rotate({{progressAngle > 180 ? 180 : progressAngle}}deg);"></view>
          </view>
          <!-- 左半圆边框：显示180-360度的部分 -->
          <view class="progress-half-wrapper progress-left-wrapper" wx:if="{{progressAngle > 180}}">
            <view class="progress-half progress-left" style="transform: rotate({{progressAngle - 180}}deg);"></view>
          </view>
        </view>
        <view class="timer-button-inner">
          <text class="timer-icon">{{isPaused ? '▶' : '⏸'}}</text>
        </view>
      </view>
    </view>
    <view class="timer-text">
      <text class="timer-label">准备时间：</text>
      <text class="timer-value">{{timerText}}</text>
    </view>
  </view>
</view>

