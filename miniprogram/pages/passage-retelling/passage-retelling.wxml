<!--passage-retelling.wxml-->
<view class="passage-retelling-container">
  <!-- 题目标题 -->
  <view class="question-title" wx:if="{{questionTitle}}">{{questionTitle}}</view>

  <!-- 第一部分和第二部分：共用白色底板 -->
  <view class="content-wrapper" wx:if="{{showContent}}">
    <view class="section-header">
      <text class="section-title">四、短文复述及提问（共{{maxScore}}分）</text>
    </view>

    <view class="question-content">
      <view class="section-subtitle">第一节 短文复述</view>
      <view class="content-text">
        <text>你将听到{{theme}}，录音播放两遍。请根据所听到的内容，依据思维导图的提示，在60秒内复述短文。</text>
      </view>
      <view class="content-text">
        <text>现在，你有15秒钟的时间阅读思维导图。</text>
      </view>
      <view class="content-text">
        <text>你的复述可以这样开始：{{example}}</text>
      </view>
      <!-- 思维导图图片 -->
      <image
        wx:if="{{imgUrl}}"
        class="mind-map-image"
        src="{{imgUrl}}"
        mode="aspectFit"
      ></image>
    </view>
  </view>

  <!-- 题目说明/旁白倒计时 -->
  <countdown-timer
    id="audioTimer"
    duration="{{currentAudioDuration}}"
    label="{{currentStepText}}"
    bind:finish="onAudioTimerFinish"
    wx:if="{{showAudioTimer}}"
  />

  <!-- 阅读时间倒计时 -->
  <countdown-timer
    id="readingTimer"
    duration="{{readingDuration}}"
    label="{{currentStepText}}"
    bind:finish="onReadingTimerFinish"
    wx:if="{{showReadingTimer}}"
  />

  <!-- 准备回答倒计时 -->
  <countdown-timer
    id="prepareTimer"
    duration="{{prepareDuration}}"
    label="{{currentStepText}}"
    bind:finish="onPrepareTimerFinish"
    wx:if="{{showPrepareTimer}}"
  />

  <!-- 录音倒计时 -->
  <countdown-timer
    id="recordingTimer"
    duration="{{recordingDuration}}"
    label="{{currentStepText}}"
    allowEarlyStop="{{true}}"
    bind:finish="onRecordingTimerFinish"
    bind:earlystop="onEarlyStopRecording"
    wx:if="{{showRecordingTimer}}"
  />
</view>
