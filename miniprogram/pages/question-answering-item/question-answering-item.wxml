<!--question-answering-item.wxml-->
<view class="question-answering-item-container">
  <view class="content-wrapper">
    <view class="section-header">
      <text class="section-title">二、信息获取(共10分)</text>
    </view>

    <view class="question-content">
      <!-- 固定旁白文字 -->
      <view class="instruction-text">现在，你有15秒钟的时间阅读这四个问题。</view>

      <!-- 当前题目（无题号） -->
      <view class="question-item" wx:if="{{currentQuestion}}">
        <view class="question-text">{{currentQuestion.content}}</view>
      </view>
    </view>
  </view>

  <!-- 播放音频倒计时 -->
  <countdown-timer
    id="audioTimer"
    duration="{{currentAudioDuration}}"
    label="{{currentStepText}}"
    bind:finish="onAudioTimerFinish"
    wx:if="{{showAudioTimer}}"
  />

  <!-- 录音倒计时 -->
  <countdown-timer
    id="recordingTimer"
    duration="{{recordingDuration}}"
    label="{{currentStepText}}"
    allowEarlyStop="{{true}}"
    bind:finish="onRecordingTimerFinish"
    bind:earlystop="onEarlyStopRecording"
    wx:if="{{showRecordingTimer}}"
  />

  <button wx:if="{{submitFailed}}" bindtap="retrySubmit">重新上传</button>
</view>
