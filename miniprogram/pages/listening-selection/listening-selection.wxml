<!--listening-selection.wxml-->
<view class="listening-selection-container">
  <!-- 题目标题 -->
  <view class="question-title">{{questionTitle}}</view>

  <!-- 静态说明区域 -->
  <view class="content-wrapper" wx:if="{{!showContent}}">
    <view class="section-header">
      <text class="section-title">二、听选信息（共{{maxScore}}分）</text>
    </view>

    <view class="question-content">
      <view class="section-subtitle">第一节 听选信息(1*6=6)</view>
      <view class="content-text">听三段对话，每段播放两遍。各段播放前你有10秒钟的阅题时间。各段播放后有两个问题。请根据所听到的问题和括号内的提示，选择正确的信息在8秒钟内口头回答。</view>
    </view>
  </view>

  <!-- 动态内容区域 -->
  <view class="content-wrapper dynamic-content" wx:if="{{showContent}}">
    <view class="section-header">
      <text class="section-title">二、听选信息（共{{maxScore}}分）</text>
      <text class="section-progress" wx:if="{{currentGlobalQuestionIndex}}">第 {{currentDialogIndex + 1}} 段 · 第 {{currentGlobalQuestionIndex}}/6 题</text>
    </view>

    <!-- 旁白内容（带题目） -->
    <block wx:if="{{currentContentType === 'preface' && currentContent.preface}}">
      <view class="preface-text">{{currentContent.preface.title_content}}</view>
      <view class="questions-section" wx:if="{{currentContent.questions && currentContent.questions.length > 0}}">
        <view class="question-item" wx:for="{{currentContent.questions}}" wx:for-index="qIdx" wx:key="qIdx">
          <text class="question-text">{{item.content}}</text>
        </view>
      </view>
    </block>

    <!-- 纯题目内容（阅题/录音时显示） -->
    <block wx:if="{{currentContentType === 'question' && currentContent.questions && currentContent.questions.length > 0}}">
      <view class="preface-text">{{currentContent.title_content}}</view>
      <view class="questions-section">
        <view class="question-item" wx:for="{{currentContent.questions}}" wx:for-index="qIdx" wx:key="qIdx">
          <text class="question-text">{{item.content}}</text>
          <view class="question-options" wx:if="{{item.options}}">
            <text wx:for="{{item.options}}" wx:for-index="oIdx" wx:key="oIdx" class="option-text">{{item}}</text>
          </view>
        </view>
      </view>
    </block>
  </view>

  <!-- 播放音频倒计时 -->
  <countdown-timer
    id="audioTimer"
    duration="{{currentAudioDuration}}"
    label="{{currentStepText}}"
    phase="playback"
    bind:finish="onAudioTimerFinish"
    wx:if="{{showAudioTimer}}"
  />

  <!-- 阅题倒计时 -->
  <countdown-timer
    id="readingTimer"
    duration="{{readingDuration}}"
    label="{{currentStepText}}"
    phase="reading"
    bind:finish="onReadingTimerFinish"
    wx:if="{{showReadingTimer}}"
  />

  <!-- 录音倒计时 -->
  <countdown-timer
    id="recordingTimer"
    duration="{{recordingDuration}}"
    label="{{currentStepText}}"
    phase="recording"
    allowEarlyStop="{{true}}"
    bind:finish="onRecordingTimerFinish"
    bind:earlystop="onEarlyStopRecording"
    wx:if="{{showRecordingTimer}}"
  />
</view>
