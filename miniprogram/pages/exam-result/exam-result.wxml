<view class="page">
  <block wx:if="{{loading}}">
    <view class="result-card loading">{{lang.loading || '加载中...'}}</view>
  </block>

  <block wx:elif="{{error}}">
    <view class="result-card">
      <view class="status-icon failed">!</view>
      <view class="title">{{error}}</view>
      <button class="button" bindtap="onRefresh">{{lang.retry || '重试'}}</button>
    </view>
  </block>

  <block wx:elif="{{isReleased}}">
    <view class="result-card success">
      <view class="score-circle">
        <view class="score-value">{{totalScore}}</view>
        <view class="score-max">/ {{paperTotalScore}}</view>
      </view>
      <view class="title">{{title}}</view>
      <view class="status released">{{statusLabel}}</view>
      <view wx:if="{{overallFeedback}}" class="feedback">
        <view class="feedback-label">{{lang.feedbackLabel || '教师评语'}}</view>
        <view class="feedback-text">{{overallFeedback}}</view>
      </view>
    </view>
  </block>

  <block wx:else>
    <view class="result-card">
      <view class="status-icon waiting">{{gradingStatus === 4 ? '×' : '⏱'}}</view>
      <view class="title">{{title}}</view>
      <view class="status pending">{{statusLabel}}</view>
      <view class="score">{{lang.fullScore || '满分'}} {{paperTotalScore}} {{lang.scoreUnit || '分'}}</view>
    </view>
  </block>

  <button class="button" bindtap="backToExamList">{{lang.backToList || '返回考试列表'}}</button>
</view>