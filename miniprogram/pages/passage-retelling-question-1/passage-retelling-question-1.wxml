<!--passage-retelling-question-1.wxml-->
<view class="passage-retelling-question-1-container">
  <view class="question-progress">第二节 · 提问 第 1/2 题</view>
  <!-- 内容区域 -->
  <view class="content-wrapper" wx:if="{{showContent}}">
    <view class="section-header">
      <text class="section-title">三、短文复述及提问（共11分）</text>
    </view>

    <view class="question-content">
      <view class="section-subtitle">第二节 提问（1.5x2=3分）</view>

      <!-- 旁白文字 -->
      <view class="content-text" wx:if="{{prefaceText}}">
        <text>{{prefaceText}}</text>
      </view>

      <!-- 问题1 -->
      <view class="question-item">
        <view class="question-prompt">请你准备第一个问题</view>
        <view class="question-content-text">{{question.content}}</view>
      </view>
    </view>
  </view>

  <!-- 准备回答倒计时 -->
  <countdown-timer
    id="prepareTimer"
    duration="{{prepareDuration}}"
    label="{{currentStepText}}"
    phase="preparation"
    bind:finish="onPrepareTimerFinish"
    wx:if="{{showPrepareTimer}}"
  />

  <!-- 录音倒计时 -->
  <countdown-timer
    id="recordingTimer"
    duration="{{recordingDuration}}"
    label="{{currentStepText}}"
    phase="recording"
    allowEarlyStop="{{true}}"
    bind:finish="onRecordingTimerFinish"
    bind:earlystop="onEarlyStopRecording"
    wx:if="{{showRecordingTimer}}"
  />
  <button wx:if="{{submitFailed}}" bindtap="retrySubmit">重新上传</button>
</view>
