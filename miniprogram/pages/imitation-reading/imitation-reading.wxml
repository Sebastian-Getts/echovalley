<!--imitation-reading.wxml-->
<view class="imitation-reading-container">
  <!-- 题目标题 -->
  <view class="question-title">{{questionTitle}}</view>

  <!-- 第一部分和第二部分：共用白色底板 -->
  <view class="content-wrapper">
    <view class="section-header">
      <text class="section-title">一、模仿朗读（共{{maxScore}}分）</text>
    </view>

    <view class="question-content">
      <view class="content-text">{{questionContent}}</view>
    </view>
  </view>

  <!-- 第三部分：时间控制区域 -->
  <!-- 第一阶段：旁白播放 -->
  <countdown-timer
    id="phase1Timer"
    duration="{{phase1Duration}}"
    label="题目说明"
    phase="playback"
    bind:finish="onAudioTimerVisualFinish"
  wx:if="{{showPhase1Timer}}"
  />

  <!-- 第二阶段：短文播放 -->
  <countdown-timer
    id="phase2Timer"
    duration="{{phase2Duration}}"
    label="播放录音"
    phase="playback"
    bind:finish="onAudioTimerVisualFinish"
  wx:if="{{showPhase2Timer}}"
  />

  <!-- 第三阶段：准备录音 -->
  <countdown-timer
    id="phase3Timer"
    duration="{{phase3Duration}}"
    label="准备朗读"
    phase="preparation"
    bind:finish="onPhase3Finish"
  wx:if="{{showPhase3Timer}}"
  />

  <!-- 第四阶段：录音 -->
  <countdown-timer
    id="phase4Timer"
    duration="{{phase4Duration}}"
    label="开始录音"
    phase="recording"
    allowEarlyStop="{{true}}"
    bind:finish="onPhase4Finish"
    bind:earlystop="onEarlyStopRecording"
  wx:if="{{showPhase4Timer}}"
  />
</view>
