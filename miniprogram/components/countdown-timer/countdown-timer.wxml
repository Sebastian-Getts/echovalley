<!--components/countdown-timer/countdown-timer.wxml-->
<view class="countdown-timer-control phase-{{phase}}">
  <view class="timer-button-container">
    <!-- 进度圆圈：使用 conic-gradient 实现平滑圆弧，从12点钟位置开始 -->
    <view class="timer-progress-ring" style="--progress: {{progressPercent}}%;">
      <!-- 中间的白色圆，形成圆环效果 -->
      <view class="timer-progress-inner"></view>
    </view>
    <!--
      录音阶段（allowEarlyStop=true）：红色停止按钮，可点击提前结束。
      播放/阅题/准备阶段（allowEarlyStop=false）：纯状态动画（脉动圆点），
      不显示"暂停"图标，避免学生误以为可以暂停或跳过。
    -->
    <view class="timer-button {{allowEarlyStop ? 'timer-button-recording' : 'timer-button-status'}}" bindtap="onControlTap">
      <view class="timer-button-inner">
        <view class="stop-icon" wx:if="{{allowEarlyStop}}"></view>
        <view class="status-pulse" wx:else></view>
      </view>
    </view>
  </view>
  <view class="timer-text">
    <text class="timer-label">{{label}}：</text>
    <text class="timer-value">{{timerText}}</text>
  </view>
</view>
